# =======================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PLATAFORMA ATLAN
# =======================================================
# Copia este archivo a '.env' en el servidor de Azure:
# cp .env.example .env
# Y rellena con las credenciales reales de tu proyecto.
# NUNCA subas el archivo '.env' con valores reales a GitHub.

# Supabase (Base de datos y autenticación en la nube)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon_de_supabase
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secreta_service_role

# Mapbox (Servicio de mapas y geocodificación)
NEXT_PUBLIC_MAPBOX_TOKEN=tu_token_publico_de_mapbox

# Entorno de ejecución
NODE_ENV=production
PORT=3000
